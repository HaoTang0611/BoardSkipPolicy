/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU
BEGIN
    POPUP "檔案(&F)"
    BEGIN
        MENUITEM "開啟新檔(&N)\tCtrl+N",            ID_FILE_NEW
        MENUITEM "開啟舊檔(&O)...\tCtrl+O",         ID_FILE_OPEN
        MENUITEM "儲存檔案(&S)\tCtrl+S",            ID_FILE_SAVE
        MENUITEM "另存新檔(&A)...",                 ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "列印(&P)...\tCtrl+P",           ID_FILE_PRINT
        MENUITEM "預覽列印(&V)",                    ID_FILE_PRINT_PREVIEW
        MENUITEM "列印設定(&R)...",                 ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "最近開啟檔案",                      ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "結束(&X)",                      ID_APP_EXIT
    END
    POPUP "專案(&P)"
    BEGIN
        MENUITEM "建立新檔(&N)\tCtrl+N",            ID_PROJECT_NEW
        MENUITEM "開啟專案(&O)...\tCtrl+O",         ID_PROJECT_OPEN
        MENUITEM "儲存專案(&S)\tCtrl+S",            ID_PROJECT_SAVE
        MENUITEM "另存專案(&A)...",                 ID_PROJECT_SAVE_AS
        MENUITEM "建立新整板",                       ID_PROJECT_NEW_PANEL
        MENUITEM SEPARATOR
        MENUITEM "開啟專案 II",                     ID_PROJECT_OPEN_2ND
        MENUITEM "開啟下一個專案",                     ID_PROJECT_OPEN_NEXT
        MENUITEM SEPARATOR
        MENUITEM "切換至專案1",                      ID_PROJECT_SWITCH_TO_1
        MENUITEM "切換至專案2",                      ID_PROJECT_SWITCH_TO_2
        MENUITEM "顯示文字報告",                      ID_PROJECT_SHOW_REPORT_TXT
        MENUITEM "清除專案資料庫",                     ID_PROJECT_CLEAR_PROJECT_LIBRARY
        MENUITEM "專案自動辨識封裝",                    ID_PROJECT_AUTO_LABEL_MODEL_GROUP
        MENUITEM SEPARATOR
        MENUITEM "關閉專案",                        ID_PROJECT_CLOSE
        MENUITEM "全部關閉",                        ID_PROJECT_CLOSE_ALL
        MENUITEM SEPARATOR
        MENUITEM "專案參數視窗",                      ID_VIEW_PROJECT_PARAM_WND
        MENUITEM "專案色彩設定",                      ID_SET_PROJECT_COLOR_LIST_WND
        MENUITEM "專案定位點列表視窗",                   ID_VIEW_FD_LIST_WND
        MENUITEM "專案整板列表視窗",                    ID_VIEW_PANEL_LIST_WND
        MENUITEM "專案單板列表視窗",                    ID_VIEW_BOARD_LIST_WND
        MENUITEM "專案零件列表視窗",                    ID_VIEW_COMPONENT_LIST_WND
        MENUITEM "專案條碼列表視窗",                    ID_VIEW_BARCODE_LIST_WND
        MENUITEM "專案零件警報列表視窗",                  ID_VIEW_COMPONENT_DEFECT_ALARM_LIST_WND
        MENUITEM SEPARATOR
        MENUITEM "載入離線編程",                      ID_PROJECT_LOAD_OFFLINE_FILE
        MENUITEM "建立離線編程",                      ID_PROJECT_NEW_OFFLINE
        MENUITEM "儲存CADXY檔案",                   ID_PROJECT_SAVE_CADXY_FILE
        MENUITEM "儲存SPC檔案",                     ID_PROJECT_SAVE_SPC_FILE
        MENUITEM "載入BOM檔案",                     ID_PROJECT_LOAD_BOM_FILE
        MENUITEM "儲存檢測涵蓋率",                     ID_PROJECT_SAVE_TEST_COVERAGE_FILE
        MENUITEM SEPARATOR
        MENUITEM "A段檢測",                        ID_PROJECT_DISTRICT_ACTIVE_A
        MENUITEM "B段檢測",                        ID_PROJECT_DISTRICT_ACTIVE_B
        MENUITEM SEPARATOR
    END
    POPUP "編輯(&E)"
    BEGIN
        MENUITEM "復原(&U)\tCtrl+Z",              ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "剪下(&T)\tCtrl+X",              ID_EDIT_CUT
        MENUITEM "複製(&C)\tCtrl+C",              ID_EDIT_COPY
        MENUITEM "貼上(&P)\tCtrl+V",              ID_EDIT_PASTE
        MENUITEM SEPARATOR
    END
    POPUP "檢測(&I)"
    BEGIN
        MENUITEM "在線檢測",                        ID_ONLINE_RUN
        MENUITEM "在線流片",                        ID_ONLINE_BYPASS
        MENUITEM "停止在線作業",                      ID_ONLINE_STOP
        MENUITEM SEPARATOR
        MENUITEM "對齊定位點",                       ID_TUNE_ALIGN_FIDUCIAL
        MENUITEM "調機檢測",                        ID_TUNE_INSPECTION_GROUP
        MENUITEM "單機檢測",                        ID_TUNE_INSPECTION
        MENUITEM "選取檢測(零件)",                    ID_TUNE_SELECTED_COMPONENT
        MENUITEM "選取檢測(模組)",                    ID_TUNE_SELECTED_MODEL
        MENUITEM "選取檢測(料號)",                    ID_TUNE_SELECTED_PART_NUMBER
        MENUITEM "選取檢測(模組群組)",                  ID_TUNE_SELECTED_MODEL_GROUP
        MENUITEM SEPARATOR
        MENUITEM "重複檢測",                        ID_TUNE_REPEATE_INSPECTION
    END
    POPUP "XYZ"
    BEGIN
        MENUITEM "XYZ操作",                       ID_XYZ_CTRL_GROUP
        MENUITEM "歸零(&H)",                      ID_XYZ_HOME_ALL
        MENUITEM "到原點(&T)",                     ID_XYZ_GO_TO_ORG
        MENUITEM "到焦點(&F)",                     ID_XYZ_GO_TO_FOCUS
        MENUITEM "遠離點",                         ID_XYZ_GO_TO_LEAVE
        MENUITEM SEPARATOR
    END
    POPUP "軌道"
    BEGIN
        MENUITEM "軌道操作",                        ID_LANE_CTRL_GROUP
        MENUITEM "進板(&I)",                      ID_LANE_PCB_IN
        MENUITEM "進板-2",                        ID_LANE_PCB_IN_2ND
        MENUITEM "進板-3",                        ID_LANE_PCB_IN_3RD
        MENUITEM "出板(&O)",                      ID_LANE_PCB_OUT
        MENUITEM "退板(&B)",                      ID_LANE_PCB_BACK
        MENUITEM "清板(&C)",                      ID_LANE_PCB_CLEAR
        MENUITEM "夾板(&C)",                      ID_LANE_PCB_CLAMP_ON
        MENUITEM "鬆板(&C)",                      ID_LANE_PCB_CLAMP_OFF
        MENUITEM "歸零(H)",                       ID_LANE_ADJUST_HOME
        MENUITEM "A軌道",                         ID_LANE_ACTIVE_A
        MENUITEM "B軌道",                         ID_LANE_ACTIVE_B
        MENUITEM "軌道寬度",                        ID_LANE_ADJUST_WIDTH
        MENUITEM "退出板",                         ID_LANE_PCB_BACK_OUT
    END
    POPUP "模組(&M)"
    BEGIN
        MENUITEM "新增框",                         ID_EDIT_MODEL_ADD
        MENUITEM "編輯框",                         ID_EDIT_MODEL_EDIT
        MENUITEM "編輯框(即時)",                     ID_EDIT_MODEL_SELECT
        MENUITEM "自動新增框",                       ID_EDIT_MODEL_AUTO_ADD
        MENUITEM SEPARATOR
        MENUITEM "模組底圖",                        MENU_MODEL_EDIT_CREATE_BK_IMAGE
        MENUITEM "所有模組底圖",                      MENU_MODEL_EDIT_CREATE_BK_IMAGE_ALL
    END
    POPUP "線上調機"
    BEGIN
        MENUITEM "線上檢測頁面",                      ID_VIEW_ONLINE_FORMVIEW
        MENUITEM SEPARATOR
        MENUITEM "上一筆",                         ID_ONLINE_TUNING_LAST_FILE
        MENUITEM "下一筆",                         ID_ONLINE_TUNING_NEXT_FILE
        MENUITEM "檢測列表",                        ID_ONLINE_TUNING_LIST_FILE
        MENUITEM "線上調機啟用",                      ID_SET_ONLINE_TUNING_ENABLE
        MENUITEM "調適圖表",                        ID_ONLINE_TUNING_SMART_CHART
        MENUITEM "資料統計",                        ID_ONLINE_TUNING_DATA_STATIC
        MENUITEM "歷程統計",                        ID_ONLINE_TUNING_SCAN_STATIC
    END
    POPUP "編輯頁面"
    BEGIN
        MENUITEM "編輯主頁面",                       ID_VIEW_EDIT_MAIN_VIEW
        MENUITEM "編輯模組頁面",                      ID_VIEW_EDIT_MODEL_VIEW
        MENUITEM "編輯條碼頁面",                      ID_VIEW_EDIT_BARCODE_VIEW
